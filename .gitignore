# Virtual Environment
.venv/

# DVC
# DVC storage/cache
.dvc/
.dvc/cache/
.dvc/tmp/
.dvc_storage/

# DVC-tracked data (ignore actual files, but allow .dvc metafiles)
# Raw data
data/raw/*.txt
!data/raw/*.dvc

# Processed and intermediate data
data/processed/
!data/processed/*.dvc
data/intermediate/
!data/intermediate/*.dvc

# DVC-tracked results
results/
!results/**/*.dvc

# Python
# Byte-compiled files
__pycache__/
*.pyc
*.pyd
*.pyo

# Jupyter Notebooks
**/.ipynb_checkpoints/

# Logs
*.log

# Specific file types to ignore
*.parquet
*.pkl
