# ---------------------
# Virtual Environment
# ---------------------
.venv/

# ---------------------
# Python cache & compiled
# ---------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd


# ---------------------
# Environment and logs
# ---------------------
.env
*.log

# ---------------------
# DVC folders and cache
# ---------------------
.dvc/
.dvc/cache/
.dvc/tmp/
.dvc_storage/

# ---------------------
# DVC metadata files (keep these tracked!)
# ---------------------
!*.dvc
!dvc.yaml
!dvc.lock

# ---------------------
# Raw data (ignore content, keep .dvc)
# ---------------------
data/raw/*
!data/raw/*.dvc

# ---------------------
# Processed and intermediate data
# ---------------------
data/processed/*
!data/processed/*.dvc

data/intermediate/*
!data/intermediate/*.dvc

# ---------------------
# DVC-tracked results
# ---------------------
results/*
!results/**/*.dvc

# ---------------------
# General large data files (if untracked)
# ---------------------
*.csv
*.parquet
*.pkl
